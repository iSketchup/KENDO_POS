<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Main.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Main.Views.TagView"
             x:DataType="viewModels:TagViewModel">
    <DockPanel DockPanel.Dock="Top" MaxHeight="45" Margin="0 0 0 5">
            <TextBox FontSize="8" MaxHeight="15" MaxWidth="50"
                     Margin="0 0 5 0" Name="TagTextBox" DockPanel.Dock="Left" />
            <Button Content="Add" FontSize="10" Margin="0 0 5 0"
                    Command="{Binding AddTagCommand}"
                    CommandParameter="{Binding ElementName=TagTextBox }" HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left" />
            <ScrollViewer HorizontalScrollBarVisibility="Visible" DockPanel.Dock="Left">
                <ItemsRepeater ItemsSource="{Binding shaderTags}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="5"
                                     Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Margin="0,0,0,0"
                                    CornerRadius="5"
                                    BorderBrush="Gray" BorderThickness="1"
                                    Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding  }" FontSize="10" />
                                    <!-- AI: How do Change the DataContext for axaml elements-->
                                    <Button Content="X" MaxWidth="15" MaxHeight="15" VerticalAlignment="Top"
                                            Command="{ReflectionBinding $parent[UserControl].DataContext.DeleteTagCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </DockPanel>
</UserControl>
