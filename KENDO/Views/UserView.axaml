<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Main.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Main.Views.UserView"            
             x:DataType="vm:UserViewModel">

    
    
    <StackPanel Margin="10" Spacing="15">
        <TextBox FontSize="28">Login</TextBox>
        <TextBox Watermark="Username" Text="{Binding Username}"/>
        <TextBox Watermark="Password" PasswordChar="*" Text="{Binding Password}"/>


		<!--Alternative zum Label im Avalonia-->
		<TextBlock FontSize="16" TextWrapping="Wrap">
			<Run Text="• Password must be 8 characters long" />
			<LineBreak />
			<Run Text="• Password must not have whitespaces" />
		</TextBlock>
		
		
		<TextBlock FontSize="24" Text="{Binding ErrorMessage}"
           Foreground="Red"
           HorizontalAlignment="Center"
           Margin="0,10,0,0"
           TextWrapping="Wrap"/>
		
		
        <Button Content="Submit" Command="{Binding LoginCommand }" IsDefault="True"/>
		<Button Content="You don't own a account?" Command="{Binding SwitchRegister }"/>
    </StackPanel>
    
</UserControl>
