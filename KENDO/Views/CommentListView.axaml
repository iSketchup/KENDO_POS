<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Main.Views"
             xmlns:main="clr-namespace:Main"
             xmlns:vm="clr-namespace:Main.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Main.Views.CommentListView"
             x:DataType="vm:CommentListViewModel">
            
    
    
    <StackPanel Margin="20">
        <TextBox Margin="0,10,0,0"
                CornerRadius="5"
                BorderBrush="Blue" BorderThickness="1" 
                Padding="5"/>
        <TextBlock Margin="0 5">Comments:</TextBlock>
        <ItemsRepeater ItemsSource="{Binding comments}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,10,0,0"
                            CornerRadius="5"
                            BorderBrush="Blue" BorderThickness="1"
                            Padding="5">
                        <StackPanel>
                            <TextBlock Text="{Binding Author}" FontSize="18" Margin="10,1,1,1" />
                            <TextBlock Text="{Binding Text}" FontSize="15" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
