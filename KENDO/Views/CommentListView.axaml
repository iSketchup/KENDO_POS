<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Main.Views"
             xmlns:main="clr-namespace:Main"
             xmlns:vm="clr-namespace:Main.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Main.Views.CommentListView"
             x:DataType="vm:CommentListViewModel">
    
    
    <DockPanel Margin="10 15 10 10">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox CornerRadius="5"  x:Name="CommentTextTextBox"
                     BorderBrush="Blue" BorderThickness="1" 
                     Padding="5" AcceptsReturn="True" 
                     MinLines="2" TextWrapping="Wrap" 
                     Grid.Column="0" />
            <Button Name="CommentButton" Content="Comment" 
            Command="{Binding AddCommentCommand}" 
            CommandParameter="{Binding ElementName=CommentTextTextBox }"
            Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
       
        <TextBlock DockPanel.Dock="Top" Margin="10 10 10 10" FontSize="17">Comments:</TextBlock>
        
        <Panel DockPanel.Dock="Top" Margin="0 0 0 0">
            
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsRepeater ItemsSource="{Binding comments}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,10,0,0"
                                    CornerRadius="5"
                                    BorderBrush="Blue" BorderThickness="1"
                                    Padding="5">
                                <StackPanel>
                                    <TextBlock Text="{Binding Author}" FontSize="18" MaxWidth="200000" Margin="10,1,1,1"  />
                                    <TextBlock Text="{Binding Text}" FontSize="15" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
