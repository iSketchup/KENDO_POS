<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Main.ViewModels"
             xmlns:v="clr-namespace:Main.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Main.Views.FrontPageView"
             x:DataType="vm:FrontPageViewModel">
    
            
 
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="3*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="10*"></RowDefinition>
        </Grid.RowDefinitions>
        
        <ContentControl Grid.Row="0" Grid.ColumnSpan="3" Content="{Binding TabBarViewModel}"></ContentControl>
        <ScrollViewer Grid.Column="1"
                      Grid.Row="1">
            
            <ItemsControl 
                ItemsSource="{Binding ShaderPages}">
    
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding GoToThisShader}">
                        <StackPanel Orientation="Vertical"  Margin="25" >
                            <ContentControl Width="300" Height="300" Content="{Binding}"/>
                            
                            <Label Content="{Binding Shader.ShaderName}" FontWeight="DemiBold"></Label>
                            <DockPanel>
                                <Label DockPanel.Dock="Left" FontStyle="Oblique">
                                    <Label.Content>
                                        <MultiBinding StringFormat="Author: {0}">
                                            <Binding Path="Shader.ShaderAuthor"/>
                                        </MultiBinding>
                                    </Label.Content>
                                </Label>
                                <ContentControl DockPanel.Dock="Right" Content="{Binding Like}"></ContentControl>
                                <ContentControl MaxWidth="100" DockPanel.Dock="Right" Content="{Binding Tag}"></ContentControl>
                            </DockPanel>
                        </StackPanel>
                    </Button> 
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
            
        </ScrollViewer>
        

        
        <ContentControl Grid.Column="2" Grid.Row="1" Content="{Binding FilterSelection}"></ContentControl>
        
    </Grid>
 
</UserControl>
