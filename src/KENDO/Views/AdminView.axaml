<!-- Dieses Window wurde gevibecodet mit ChatGPT -->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Main.ViewModels"
             xmlns:models="clr-namespace:Main.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Main.Views.AdminView"
             x:DataType="vm:AdminViewModel"
             x:Name="Root">
    <Grid Margin="20" RowDefinitions="Auto, *">
        <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,20">
            <TextBlock FontSize="26" FontWeight="Bold" Foreground="Red" Text="Admin Dashboard"/>
            <TextBlock FontSize="14" Text="Hier kannst du das System verwalten und User kontrollieren."/>
        </StackPanel>
        
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15">
            <ListBox ItemsSource="{Binding Users}" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:User">
                        <Grid ColumnDefinitions="*, Auto">
        
                            <TextBlock Grid.Column="0" 
                                       Text="{Binding UserName}" 
                                       FontWeight="Bold" 
                                       VerticalAlignment="Center"
                                       Foreground="Black"/> 
                    
                            <Button Grid.Column="1" 
                                    Content="Löschen" 
                                    Background="#A30000" 
                                    Foreground="White"
                                    Padding="10,5"
                                    CornerRadius="4"
                                    Command="{Binding #Root.((vm:AdminViewModel)DataContext).DeleteUserCommand}" 
                                    CommandParameter="{Binding}" />
        
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
